# TideCloak adapter JSON. Export this from the Tide-specific endpoint and keep
# the real value outside Git. Do not use the generic Keycloak adapter export.
TIDECLOAK_CONFIG_PATH=./data/tidecloak.json

# Optional alternatives to TIDECLOAK_CONFIG_PATH.
# CLIENT_ADAPTER='{"realm":"...","auth-server-url":"...","resource":"...","jwk":{"keys":[]}}'
# TIDECLOAK_CONFIG_B64=

# Fail closed for protected APIs unless deliberately disabled for a local test.
TIDECLOAK_REQUIRE_DPOP=true

# Local TideCloak setup only; never commit values.
# KC_BOOTSTRAP_ADMIN_USERNAME=admin
# KC_BOOTSTRAP_ADMIN_PASSWORD=
# TIDECLOAK_URL=http://localhost:8080
# REALM_NAME=tiderent
# CLIENT_NAME=tiderent-web
# CLIENT_APP_URL=http://localhost:3000
# TIDE_LICENSE_EMAIL=
# TIDE_TERMS_ACCEPTED=no
